# ===================================================================
# 校园活动积分平台 (EduPoint) - 生产部署环境变量模板 (.env.prod.example)
#
# 使用方式:
# 1. 复制本文件为 .env:
#    cp .env.prod.example .env
# 2. 严禁在生产环境使用弱口令或默认示例密码！
# 3. 填充下方各项强密码后，执行:
#    docker compose -f backend/deploy/docker-compose.prod.yml --env-file .env.prod up -d
# ===================================================================

# 1. MySQL 8.0 数据库 ROOT 密码 (必须修改为强密码，长度建议 >= 16 位)
MYSQL_ROOT_PASSWORD=your_strong_mysql_prod_password_here_min16chars!

# 2. Redis 7.0 内存集群访问密码 (必须修改为强密码)
REDIS_PASSWORD=your_strong_redis_prod_password_here_min16chars!

# 3. RabbitMQ 3.13 消息队列管理员凭据
RABBITMQ_USER=campus_admin
RABBITMQ_PASS=your_strong_rabbitmq_prod_password_here_min16chars!

# 4. 安全签名密钥凭据 (活动签到二维码 & 商城礼品提货动态防伪签名密钥)
ACTIVITY_QR_SIGN_SECRET=your_strong_activity_qr_prod_sign_secret_min32chars!
MALL_PICKUP_SIGN_SECRET=your_strong_mall_pickup_prod_sign_secret_min32chars!

# 5. 商汤 SenseNova 大模型 API 密钥 (生产环境 AI 客服大模型调用；留空时自动降级为本地智能工具引擎)
SENSENOVA_API_KEY=your_sensenova_api_key_here

# 6. 高德地图开放平台 Web 服务 Key 与安全密钥 (前端移动端与管理端考勤定位、地图导航使用)
VITE_AMAP_KEY=your_amap_web_key_here
VITE_AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here
