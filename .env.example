# ===================================================================
# 校园活动积分平台 (EduPoint) - 后端 Docker Compose 环境变量模板 (.env.example)
#
# 使用方式:
# 1. 复制本文件为 .env:
#    cp .env.example .env
# 2. 严禁在生产或公开环境使用弱口令！配置强密码后启动:
#    docker compose up -d
# ===================================================================

# 1. MySQL 8.0 ROOT 密码
MYSQL_ROOT_PASSWORD=your_strong_mysql_password_min16chars!

# 2. Redis 7.0 密码
REDIS_PASSWORD=your_strong_redis_password_min16chars!

# 3. RabbitMQ 凭据
RABBITMQ_USER=guest
RABBITMQ_PASS=your_strong_rabbitmq_password_min16chars!

# 4. 安全签名密钥凭据 (活动签到二维码 & 商城礼品提货动态防伪签名密钥)
ACTIVITY_QR_SIGN_SECRET=your_strong_activity_qr_sign_secret_min32chars!
MALL_PICKUP_SIGN_SECRET=your_strong_mall_pickup_sign_secret_min32chars!
